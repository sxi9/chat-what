# WhatsApp Cloud API (Meta for Developers > your app > WhatsApp > API Setup)
WA_ACCESS_TOKEN=EAAG...            # permanent system-user token in production
WA_PHONE_NUMBER_ID=123456789012345
WA_VERIFY_TOKEN=choose-any-random-string   # paste the same value in the webhook config
WA_APP_SECRET=abcdef...            # App settings > Basic > App secret; used to verify webhook signatures
WA_API_VERSION=v21.0

# Approved template names (create them in WhatsApp Manager > Message templates)
WA_TEMPLATE_JOB_ALERT=job_alert
WA_TEMPLATE_STATUS_UPDATE=application_status
WA_TEMPLATE_TICKET_REPLY=ticket_reply
WA_TEMPLATE_REMINDER=reminder
WA_TEMPLATE_LANGUAGE=en

# Backend
DATABASE_URL=sqlite:///./jobbot.db
ADMIN_API_KEY=change-me
ALERTS_PER_USER_PER_RUN=3
ALERT_LOOKBACK_DAYS=14

# Help & FAQ content (JSON list of {id, question, answer})
FAQ_FILE=jobbot/data/faq.json

# Natural-language assistant. Leave the key empty to run the deterministic menus only.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=medium            # low | medium | high
ASSISTANT_WEB_SEARCH=true
ASSISTANT_NAME=JobBot
